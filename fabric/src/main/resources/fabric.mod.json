{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "BreakInBlocks"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.breakinblocks.justenoughcraftingtables.JustEnoughCraftingTables"
    ],
    "client": [
      "com.breakinblocks.justenoughcraftingtables.client.JustEnoughCraftingTablesClient"
    ],
    "jei_mod_plugin": [
      "com.breakinblocks.justenoughcraftingtables.integration.jei.StationJeiPlugin"
    ],
    "jade": [
      "com.breakinblocks.justenoughcraftingtables.integration.jade.StationJadePlugin"
    ],
    "emi": [
      "com.breakinblocks.justenoughcraftingtables.integration.emi.StationEmiPlugin"
    ]
  },
  "mixins": [
    "justenoughcraftingtables.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": ">=0.92.12"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "craftingtweaks": "*",
    "emi": "*",
    "polymorph": "*"
  },
  "breaks": {
    "craftingstation": "*"
  }
}
